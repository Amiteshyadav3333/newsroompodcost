# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Synthesia (use the avatar's Interactive ID)
SYNTHESIA_API_KEY=your_synthesia_api_key
SYNTHESIA_AVATAR_ID=your_avatar_interactive_id
# Optional second Synthesia Interactive ID. The video switches to this avatar
# when the AI replies as guest Amitesh; both IDs must be accessible to your workspace.
SYNTHESIA_AMITESH_AVATAR_ID=your_second_avatar_interactive_id
# Optional third and fourth Synthesia Interactive IDs, in panel order.
SPEAKER_AVATAR_IDS=

# Optional: custom Cartesia voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional: separate Cartesia/Inference voice IDs for the two speakers.
# Namrata keeps TTS_VOICE by default. Amitesh defaults to Cartesia's Hindi male Dev voice.
# Set AMITESH_TTS_VOICE here only if you want to replace that default.
NAMRATA_TTS_VOICE=
# AMITESH_TTS_VOICE=910fb75e-1d20-4840-ac63-ac6b26a71bdc
# Optional voice IDs for panelists 3 and 4, comma-separated in panel order.
SPEAKER_TTS_VOICES=

# Optional
# TTS_MODEL=cartesia/sonic-3
# TTS_LANGUAGE=hi
# USE_SPRING=1
# SPRING_AVATAR_URL=http://127.0.0.1:8080/api/avatar/ask
# FAKE_BRAIN=1
